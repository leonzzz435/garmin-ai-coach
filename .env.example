# Environment variables for garmin-ai-coach (example only)
# Copy to .env or .env.dev and fill in real values. Do NOT commit real secrets.

# LLM providers (use at least one)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=...
DEEPSEEK_API_KEY=...

# Azure AI Foundry / Azure OpenAI (optional)
# Routes requests through your Azure deployment. AI_MODE determines parameter template
# (max_tokens, reasoning, etc.), DEPLOYMENT_NAME is your Azure deployment to call.
# ⚠️  Match AI_MODE to your deployment: reasoning models (o1, gpt-5) need standard/pro mode.
#    Using standard with gpt-4o-mini may cause errors if reasoning params are incompatible.
# AZURE_OPENAI_API_KEY=your-azure-api-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# Observability (optional)
LANGSMITH_API_KEY=lsv2_...

# App mode: development | standard | cost_effective | pro
# Provider mapping depends on AI mode (see services/ai/ai_settings.py:24 stage_models)
# Defaults:
#   standard -> OpenAI (gpt-5)                  | requires OPENAI_API_KEY
#   development -> Anthropic (claude-4)         | requires ANTHROPIC_API_KEY
#   cost_effective -> Anthropic (claude-3-haiku) | requires ANTHROPIC_API_KEY
#   pro -> OpenAI (gpt-5.2-pro-search for experts/planners) | requires OPENAI_API_KEY
#        ⚠️  WARNING: PRO mode can incur high costs (>$10 per run depending on data volume)
# Tip: If you only set OPENAI_API_KEY, set AI_MODE=standard or update stage_models.
AI_MODE=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
